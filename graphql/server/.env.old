# ===========================================
# SERVER ENVIRONMENT VARIABLES
# ===========================================
# This file sources values from ../.env

# Load parent environment variables
# In production, use a proper env loader or process manager

# Database Configuration (from parent .env)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Hasura Configuration (from parent .env)
HASURA_GRAPHQL_ADMIN_SECRET=myadminsecretkey
HASURA_GRAPHQL_METADATA_DATABASE_URL=postgres://postgres:postgrespassword@postgres:5432/postgres
PG_DATABASE_URL=postgres://postgres:postgrespassword@postgres:5432/postgres

# JWT Configuration (from parent .env)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=24h

# Server Configuration (from parent .env)
PORT=3000
HASURA_ENDPOINT=http://capstone_hasura:8080/v1/graphql

# Development Configuration
NODE_ENV=development

# AI Service Config
PORT=8000

# Connections
LM_STUDIO_URL=http://host.docker.internal:1234/v1 # Use this hostname to reach your host machine from a container
REDIS_HOST=redis
REDIS_PORT=6379
CHROMA_HOST=chroma
CHROMA_PORT=8000
HASURA_ENDPOINT=http://graphql-engine:8080/v1/graphql
HASURA_GRAPHQL_ADMIN_SECRET=myadminsecretkey
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123