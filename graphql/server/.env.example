# Server
PORT=3001
NODE_ENV=development

# Hasura
# The admin GraphQL endpoint this server proxies all DB access through.
HASURA_ENDPOINT=http://graphql-engine:8080/v1/graphql
HASURA_GRAPHQL_ADMIN_SECRET=myadminsecretkey

# JWT
# JWT_SECRET must be byte-identical to HASURA_GRAPHQL_JWT_SECRET.key configured
# on the Hasura engine, or every token will be rejected there.
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=24h

# MinIO
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
# Browser-facing base URL used to sign presigned download links (S3 signatures
# cover the Host header, so internal endpoint names like "minio" won't work in
# a browser). Falls back to http://MINIO_ENDPOINT:MINIO_PORT when unset.
MINIO_PUBLIC_URL=http://localhost:9000

# OpenAI
# Leave empty to run the /api/ai/* routes against canned offline fixtures.
OPENAI_API_KEY=
