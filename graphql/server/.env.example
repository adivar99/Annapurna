# Server
PORT=3001
NODE_ENV=development

# Hasura
# The admin GraphQL endpoint this server proxies all DB access through.
HASURA_ENDPOINT=http://graphql-engine:8080/v1/graphql
HASURA_GRAPHQL_ADMIN_SECRET=myadminsecretkey

# JWT
# JWT_SECRET must be byte-identical to HASURA_GRAPHQL_JWT_SECRET.key configured
# on the Hasura engine, or every token will be rejected there.
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=24h

# MinIO
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
# Browser-facing base URL used to sign presigned download links (S3 signatures
# cover the Host header, so internal endpoint names like "minio" won't work in
# a browser). Falls back to http://MINIO_ENDPOINT:MINIO_PORT when unset.
MINIO_PUBLIC_URL=http://localhost:9000

# AI
# The chat-completion client speaks the OpenAI schema, so it works against
# api.openai.com or any OpenAI-compatible endpoint such as OpenRouter.
# Leave OPENAI_API_KEY empty to run the /api/ai/* routes against canned
# offline fixtures instead.
OPENAI_API_KEY=
# Defaults below point at OpenAI. For OpenRouter, set:
#   AI_BASE_URL=https://openrouter.ai/api/v1
#   AI_CHAT_MODEL=anthropic/claude-haiku-5.5   (vendor-qualified model ID)
AI_BASE_URL=https://api.openai.com/v1
AI_CHAT_MODEL=gpt-4o-mini
# Optional app attribution (used by OpenRouter for rankings/dashboard labels).
# AI_APP_REFERER=http://localhost:3004
AI_APP_TITLE=Annapurna
