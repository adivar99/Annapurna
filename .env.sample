# Project
PROJECT_NAME="Annapurna"
PROJECT_VERSION=1.0.0

SUPERUSER_EMAIL="admin@annapurna.com"
SUPERUSER_PASSWORD="admin_password_here"

SECRET_KEY="your-secret-key-here"

# OPENAI
OPENAI_API_KEY=""

# Hasura
HASURA_ENDPOINT=http://localhost:8080
HASURA_GRAPHQL_ADMIN_SECRET="your-admin-secret-here"
HASURA_GRAPHQL_JWT_SECRET='{"type":"HS256", "key":"your-super-secret-jwt-key-change-this-in-production"}'

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD="your-postgres-password-here"
POSTGRES_DB=pg_db
POSTGRES_PORT=5432